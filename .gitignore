# Compiled Java class files
*.class

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# Maven build outputs
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Node & Frontend build outputs
node_modules/
dist/
dist-ssr/
*.local

# Secrets and environment configurations
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.p12

# IDE and Editor directories
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.settings/
.project
.classpath
.factorypath
*.sublime-project
*.sublime-workspace

# Operating System specific
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
