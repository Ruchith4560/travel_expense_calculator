# ==============================================================================
# Backend Environment Configuration (.env.example)
# ==============================================================================

# Active Spring Profile (dev or prod)
SPRING_PROFILES_ACTIVE=dev

# Server Port
PORT=8080

# Production PostgreSQL Database Credentials (used when profile is 'prod')
DATABASE_URL=jdbc:postgresql://localhost:5432/travelexpensedb
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Allowed CORS Origins (comma-separated for multi-origin access)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
