# ==============================================================================
# Frontend Environment Configuration (.env.example)
# ==============================================================================

# Base URL for the Spring Boot REST API
# Leave blank or use /api to use the Vite dev proxy during development
# In production, set to your deployed backend URL (e.g. https://api.voyageledger.com)
VITE_API_BASE_URL=

# Vite Dev Server Port
VITE_PORT=5173
